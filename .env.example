# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=
DB_SSL_CA=ca.pem

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend (React) addresses allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Password given to the demo accounts created by /setup/seed (development only)
SEED_PASSWORD=

# Google login (Client ID from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=

# Email API (Brevo). Leave empty to only log emails as "queued".
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Calapan City Clinic

# Email API (Brevo). MAIL_FROM must be a sender you verified in Brevo.
# (BREVO_API_KEY, MAIL_FROM, MAIL_FROM_NAME are listed above)

# Google Calendar (service account). Use ONE of: the key file's contents, a path to the file
# (for example google-key.json), or the base64 text of the file (easiest on Render).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Windows only: if emails or Google calls fail with an "SSL certificate" error, download
# https://curl.se/ca/cacert.pem into the project folder and set this to cacert.pem
CURL_CA_BUNDLE=

